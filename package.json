{
  "name": "vite_react_shadcn_ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "size": "vite build && size-limit",
    "preview": "vite preview",
    "test:visual:ref": "npm run build && concurrently -k --success first \"vite preview --port 4173 --strictPort\" \"wait-on http://localhost:4173 && backstop reference\"",
    "test:visual": "npm run build && concurrently -k --success first \"vite preview --port 4173 --strictPort\" \"wait-on http://localhost:4173 && backstop test\"",
    "test:visual:approve": "backstop approve"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^0.462.0",
    "nitro": "^3.0.260429-beta",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@dyad-sh/react-vite-component-tagger": "^0.9.0",
    "@eslint/js": "^9.9.0",
    "@size-limit/preset-app": "^14.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "backstopjs": "^6.3.25",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.47",
    "size-limit": "^14.0.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.0.0",
    "wait-on": "^9.1.0"
  },
  "size-limit": [
    {
      "name": "JS inicial (gzip)",
      "path": ".output/public/assets/index-*.js",
      "limit": "380 kB",
      "gzip": true
    },
    {
      "name": "CSS (gzip)",
      "path": ".output/public/assets/index-*.css",
      "limit": "30 kB",
      "gzip": true
    }
  ]
}
